#--------------------------------------------------------------------
# EMAIL (Rechnungsversand, Issue #35)
#--------------------------------------------------------------------
# Ohne diese Keys bleibt der E-Mail-Versand in der UI deaktiviert.

# email.protocol = smtp
# email.SMTPHost = mail.example.org
# email.SMTPUser = kassenwart@example.org
# email.SMTPPass = geheim
# email.SMTPPort = 587
# email.SMTPCrypto = tls
# email.fromEmail = kassenwart@example.org
# email.fromName = 'VDSt Kassenwart'
# Eine SMTP-Verbindung für den ganzen Batch offen halten (Reihenversand):
# email.SMTPKeepAlive = true

#--------------------------------------------------------------------
# VDSt (App-Konfiguration)
#--------------------------------------------------------------------
# Name des Kassenwarts für PDF-Fußzeile und Mail-Signatur des Versands.
# Ohne diesen Key signieren Rechnungen generisch mit "der Kassenwart".

# vdst.kassenwart_name = 'Max Mustermann'

# Empfänger des automatischen Monats-Versands der Abrechnungen (Issue #37,
# `php spark abrechnungen:versenden`). Der Job schickt die offene AH-/HV-
# Abrechnung als ZIP (Excel + Belege) an diese Adresse zum Prüfen/Weiterleiten.
# Ohne diesen Key (oder ohne email.*) ist der Auto-Versand deaktiviert.

# vdst.kassenwart_email = 'kassenwart@example.org'

# Verbindungszeichen für die Mail-Signatur ("Kassenwart {Zeichen}"), z.B. das
# Bandzeichen. Ohne diesen Key endet die Signatur schlicht mit "Kassenwart".

# vdst.kassenwart_zeichen = 'V!!!'

# Bankverbindung für den Überweisungs-Absatz im Rechnungsversand-Mailtext
# (Issue #60). Der ganze Absatz ("Falls du kein Lastschriftmandat erteilt
# hast...") wird NUR gerendert, wenn vdst.bank_iban gesetzt ist — ohne IBAN
# bleibt es beim reinen Lastschrift-Hinweis.

# vdst.bank_kontoinhaber = 'VDSt zu Erlangen'
# vdst.bank_iban = 'DE00 0000 0000 0000 0000 00'
# vdst.bank_bic = 'ABCDEFGHXXX'
# vdst.bank_name = 'Musterbank Erlangen'
